# Set this to the URL of the backend API when the backend is hosted separately.
# Leave blank only when the frontend and API share the same origin.
VITE_API_BASE_URL=

# Optional separate GPU-hosted LTX Lite service URL (for example http://localhost:7860).
# Leave blank to use the existing WAN 2.2 hosted inference path.
VITE_LTX_API_URL=
